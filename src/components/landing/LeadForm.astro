---
import { useTranslations } from '../../utils/i18n'

interface Props {
  locale: 'es' | 'en'
  phone: string
}

const { locale, phone } = Astro.props
const t = useTranslations(locale)

type Question = { id: string; label: string; options: string[] }
const questions = t('Landing.form.questions') as unknown as Question[]
const messageLabels = t('Landing.form.message') as unknown as Record<string, string>
const total = questions.length + 1
---

<div class='lead-card'>
  <div class='lead-progress' aria-hidden='true'>
    <span class='lead-progress-bar' data-progress></span>
  </div>

  <form
    id='lead-form'
    class='lead-form'
    novalidate
    data-phone={phone}
    data-total={total}
    data-labels={JSON.stringify(messageLabels)}>
    <p class='lead-step-count' aria-live='polite'>
      {t('Landing.form.stepLabel')} <span data-current>1</span> {t('Landing.form.of')} {total}
    </p>

    {questions.map((question, index) => (
      <fieldset class='lead-step' data-step={index} hidden={index !== 0}>
        <legend class='lead-legend'>{question.label}</legend>
        <div class='lead-options'>
          {question.options.map(option => (
            <label class='lead-option'>
              <input type='radio' name={question.id} value={option} class='sr-only' />
              <span>{option}</span>
              <svg class='lead-option-check' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12l5 5L20 7'/></svg>
            </label>
          ))}
        </div>
      </fieldset>
    ))}

    <fieldset class='lead-step' data-step={questions.length} hidden>
      <legend class='lead-legend'>{t('Landing.form.contact.label')}</legend>
      <div class='grid gap-3'>
        <label class='sr-only' for='lead-name'>{t('Landing.form.contact.name')}</label>
        <input id='lead-name' name='name' type='text' autocomplete='name' required maxlength='80' class='lead-input' placeholder={t('Landing.form.contact.name')} />
        <label class='sr-only' for='lead-business'>{t('Landing.form.contact.business')}</label>
        <input id='lead-business' name='business' type='text' autocomplete='organization' maxlength='80' class='lead-input' placeholder={t('Landing.form.contact.business')} />
        <label class='sr-only' for='lead-notes'>{t('Landing.form.contact.message')}</label>
        <textarea id='lead-notes' name='notes' rows='3' maxlength='500' class='lead-input resize-none' placeholder={t('Landing.form.contact.message')}></textarea>
        <p class='lead-error' data-error hidden>{t('Landing.form.contact.required')}</p>
        <button type='submit' class='btn primary w-full mt-1'>
          <svg width='18' height='18' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'><path d='M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.43 9.43 0 0 1-4.8-1.32l-.35-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.44 9.45-9.44 2.52 0 4.9.99 6.68 2.77a9.38 9.38 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.45 9.44m8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.68 5.8.68 12.06c0 2 .52 3.96 1.52 5.68L.58 23.3l5.7-1.5a11.33 11.33 0 0 0 5.77 1.47h.01c6.26 0 11.36-5.1 11.36-11.36 0-3.03-1.18-5.89-3.33-8.03'/></svg>
          {t('Landing.form.contact.submit')}
        </button>
        <p class='text-xs text-white/50 text-center'>{t('Landing.form.contact.note')}</p>
      </div>
    </fieldset>

    <button type='button' class='lead-back' data-back hidden>
      <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5M12 19l-7-7 7-7'/></svg>
      {t('Landing.form.back')}
    </button>
  </form>

  <div class='lead-success' data-success hidden tabindex='-1'>
    <span class='lead-success-icon' aria-hidden='true'>
      <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12l5 5L20 7'/></svg>
    </span>
    <h3 class='text-2xl md:text-3xl text-white'>{t('Landing.form.success.title')}</h3>
    <p class='text-white/70'>
      {t('Landing.form.success.text')}
      <a href='#' data-success-link data-no-track class='text-accent underline underline-offset-4' target='_blank' rel='noopener noreferrer'>
        {t('Landing.form.success.link')}
      </a>
    </p>
  </div>
</div>

<style>
  .lead-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.75rem 1.25rem 1.5rem;
  }

  @media (min-width: 768px) {
    .lead-card {
      padding: 2.5rem 2.25rem 2rem;
    }
  }

  .lead-progress {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: rgb(255 255 255 / 0.08);
  }

  .lead-progress-bar {
    display: block;
    height: 100%;
    width: 20%;
    background: var(--color-primary);
    transition: width 0.5s var(--ease-out-expo);
  }

  .lead-step-count {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .lead-step {
    margin-top: 0.75rem;
    animation: lead-in 0.45s var(--ease-out-expo);
  }

  .lead-step[hidden] {
    display: none;
  }

  @keyframes lead-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }

  .lead-legend {
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
    color: white;
  }

  .lead-options {
    display: grid;
    gap: 0.625rem;
  }

  @media (min-width: 640px) {
    .lead-options {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lead-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.875rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.9);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .lead-option:hover {
    border-color: var(--color-primary);
  }

  .lead-option:has(input:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .lead-option:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-black);
  }

  .lead-option-check {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lead-option:has(input:checked) .lead-option-check {
    opacity: 1;
  }

  .lead-input {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.875rem;
    background: rgb(255 255 255 / 0.03);
    color: white;
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }

  .lead-input::placeholder {
    color: rgb(255 255 255 / 0.4);
  }

  .lead-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .lead-input[aria-invalid='true'] {
    border-color: #f87171;
  }

  .lead-error {
    font-size: 0.8125rem;
    color: #fca5a5;
  }

  .lead-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.6);
    cursor: pointer;
  }

  .lead-back:hover {
    color: white;
  }

  .lead-back[hidden] {
    display: none;
  }

  .lead-success {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: 1rem 0;
    outline: none;
  }

  .lead-success[hidden] {
    display: none;
  }

  .lead-success-icon {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    padding: 0.75rem;
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-black);
  }
</style>

<script>
  type Answers = Record<string, string>

  const form = document.querySelector<HTMLFormElement>('#lead-form')

  const track = (event: string, params: Record<string, unknown> = {}) => {
    const w = window as any
    if (typeof w.gtag === 'function') w.gtag('event', event, params)
    if (event === 'generate_lead' && typeof w.fbq === 'function') w.fbq('track', 'Lead', params)
  }

  /** UTMs / click IDs del anuncio, guardados al aterrizar (ver página) */
  const readSource = () => {
    try {
      const raw = sessionStorage.getItem('lp-source')
      return raw ? (JSON.parse(raw) as Record<string, string>) : {}
    } catch {
      return {}
    }
  }

  if (form) {
    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.lead-step'))
    const total = steps.length
    const card = form.closest<HTMLElement>('.lead-card')!
    const bar = card.querySelector<HTMLElement>('[data-progress]')!
    const current = form.querySelector<HTMLElement>('[data-current]')!
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!
    const error = form.querySelector<HTMLElement>('[data-error]')!
    const nameInput = form.querySelector<HTMLInputElement>('#lead-name')!
    const success = card.querySelector<HTMLElement>('[data-success]')!
    const successLink = card.querySelector<HTMLAnchorElement>('[data-success-link]')!
    const labels = JSON.parse(form.dataset.labels || '{}') as Record<string, string>
    const phone = form.dataset.phone!

    let step = 0
    let started = false

    const show = (index: number) => {
      step = index
      steps.forEach((el, i) => (el.hidden = i !== index))
      current.textContent = String(index + 1)
      bar.style.width = `${((index + 1) / total) * 100}%`
      back.hidden = index === 0
    }

    form.addEventListener('change', e => {
      const input = e.target as HTMLInputElement
      if (input.type !== 'radio') return
      if (!started) {
        started = true
        track('form_start', { form_id: 'lead-form' })
      }
      track('form_step', { step: input.name, value: input.value })
      // Pequeña pausa para que se vea la selección antes de avanzar
      window.setTimeout(() => {
        show(Math.min(step + 1, total - 1))
        if (step === total - 1) nameInput.focus({ preventScroll: true })
      }, 260)
    })

    back.addEventListener('click', () => show(Math.max(step - 1, 0)))

    form.addEventListener('submit', e => {
      e.preventDefault()
      const data = new FormData(form)
      const name = String(data.get('name') || '').trim()

      if (!name) {
        error.hidden = false
        nameInput.setAttribute('aria-invalid', 'true')
        nameInput.focus()
        return
      }
      error.hidden = true
      nameInput.removeAttribute('aria-invalid')

      const answers: Answers = {}
      for (const key of ['service', 'stage', 'budget', 'timeline', 'business', 'notes']) {
        const value = String(data.get(key) || '').trim()
        if (value) answers[key] = value
      }

      const source = readSource()
      const origin = [source.utm_source, source.utm_campaign].filter(Boolean).join(' / ')

      const lines = [
        labels.greeting,
        '',
        `• ${labels.name}: ${name}`,
        ...['business', 'service', 'stage', 'budget', 'timeline', 'notes']
          .filter(key => answers[key])
          .map(key => `• ${labels[key]}: ${answers[key]}`),
        ...(origin ? ['', `${labels.source}: ${origin}`] : []),
      ]

      const url = `https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`

      track('generate_lead', {
        method: 'form',
        link_location: 'lead-form',
        service: answers.service,
        budget: answers.budget,
        timeline: answers.timeline,
      })

      successLink.href = url
      form.hidden = true
      card.querySelector<HTMLElement>('.lead-progress')!.hidden = true
      success.hidden = false
      success.focus({ preventScroll: true })

      // Sin 'noopener' en los features: con él window.open devuelve siempre null
      // y no podríamos detectar si el navegador bloqueó la ventana.
      const win = window.open(url, '_blank')
      if (win) win.opener = null
      else window.location.href = url
    })

    show(0)
  }
</script>
