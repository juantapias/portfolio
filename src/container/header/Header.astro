---
import { useTranslations } from '../../utils/i18n'

const locale = Astro.currentLocale as 'es' | 'en'
const t = useTranslations(locale)

const headerLink = [
  { label: t('Nav.home'), link: '#banner' },
  { label: t('Nav.works'), link: '#works' },
  { label: t('Nav.services'), link: '#services' },
  { label: t('Nav.about'), link: '#about' },
  { label: t('Nav.contact'), link: '#contact' },
]
---

<header class="header">
  <a href={`/${locale}`} class="logo" aria-label="Tapias — home">
    Tapias<span class="logo-dot">.</span>
  </a>

  <!-- Desktop navigation -->
  <nav class="navigation desktop-navigation" aria-label="Main navigation">
    {headerLink.map(item => (
      <a
        href={item.link}
        class="navigation-link navigation-link-inactive">
        {item.label}
      </a>
    ))}
    <span class="navigation-indicator"></span>
  </nav>

  <div class="header-actions">
    <!-- Locale switch -->
    <div class="locale-switch">
      <a
        href="#"
        data-locale="es"
        class={`locale-link ${locale === 'es' ? 'active' : ''}`}
      >ES</a>
      <a
        href="#"
        data-locale="en"
        class={`locale-link ${locale === 'en' ? 'active' : ''}`}
      >EN</a>
    </div>

    <a
      href="https://wa.link/63go9c"
      target="_blank"
      rel="noopener noreferrer"
      class="btn default arrow small header-cta">
      {t('Nav.cta')}
      <span class="btn-arrow-icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </span>
    </a>

    <!-- Mobile menu button -->
    <button
      class="mobile-menu-button"
      aria-label="Toggle mobile menu"
      aria-expanded="false">
      <span class="hamburger"></span>
    </button>
  </div>

  <!-- Mobile navigation -->
  <nav class="mobile-navigation" aria-label="Mobile navigation">
    <ul class="mobile-navigation-list">
      {headerLink.map((item, index) => (
        <li class="mobile-navigation-item">
          <a
            href={item.link}
            class="mobile-navigation-link">
            <span class="mobile-navigation-index">0{index + 1}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="mobile-locale-switch">
      <a
        href="#"
        data-locale="es"
        class={`locale-link ${locale === 'es' ? 'active' : ''}`}
      >ES</a>
      <a
        href="#"
        data-locale="en"
        class={`locale-link ${locale === 'en' ? 'active' : ''}`}
      >EN</a>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  @media (min-width: 1024px) {
    .header {
      padding: 1.25rem 2.5rem;
    }
  }

  /* =====================
     Logo
  ===================== */

  .logo {
    justify-self: start;
    font-family: var(--font-display);
    line-height: 1;
    color: white;
    position: relative;
    z-index: 20;
    padding: 0.5rem 1rem 0.625rem;
    border-radius: 9999px;
    background: rgba(20, 18, 16, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: 1.375rem;
  }

  .logo-dot {
    color: var(--color-primary);
  }

  /* =====================
     Navigation (pill)
  ===================== */

  .navigation {
    position: relative;
    display: flex;
    gap: 0.25rem;
    padding: 0.3125rem;
    border-radius: 9999px;
    background: rgba(20, 18, 16, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .navigation-indicator {
    position: absolute;
    top: 0.3125rem;
    bottom: 0.3125rem;
    left: 0;
    width: 0;
    background: white;
    border-radius: 9999px;
    z-index: 0;
  }

  .navigation-link {
    position: relative;
    z-index: 1;
    padding: 0.5rem 1rem;
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 9999px;
    transition: color 0.3s ease;
  }

  .navigation-link-inactive:hover {
    color: var(--color-accent);
  }

  .navigation-link-active {
    color: var(--color-black);
  }

  @media (max-width: 1100px) {
    .navigation-link {
      padding: 0.5rem 0.75rem;
    }
  }

  @media (max-width: 900px) {
    .desktop-navigation {
      display: none;
    }
  }

  /* =====================
     Right side actions
  ===================== */

  .header-actions {
    position: relative;
    z-index: 20;
    grid-column: 3;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .locale-switch {
    display: flex;
    padding: 0.25rem;
    border-radius: 9999px;
    background: rgba(20, 18, 16, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .locale-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.6rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    border-radius: 9999px;
    transition: color 0.3s ease, background 0.3s ease;
  }

  .locale-link:hover {
    color: white;
  }

  .locale-link.active {
    background: white;
    color: var(--color-black);
  }

  @media (max-width: 640px) {
    .locale-switch,
    .header-cta {
      display: none;
    }
  }

  /* =====================
     Mobile Menu Button
  ===================== */

  .mobile-menu-button {
    display: none;
    position: relative;
    z-index: 20;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: white;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .mobile-menu-button {
      display: flex;
    }
  }

  .hamburger {
    position: relative;
    width: 18px;
    height: 2px;
    background-color: var(--color-black);
    display: block;
    transition: all 0.3s ease;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background-color: var(--color-black);
    transition: all 0.3s ease;
  }

  .hamburger::before {
    transform: translateY(-6px);
  }

  .hamburger::after {
    transform: translateY(6px);
  }

  .hamburger.open {
    background-color: transparent;
  }

  .hamburger.open::before {
    transform: rotate(45deg);
  }

  .hamburger.open::after {
    transform: rotate(-45deg);
  }

  /* =====================
     Mobile Navigation
  ===================== */

  .mobile-navigation {
    position: fixed;
    inset: 0;
    z-index: 15;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2.5rem;
    padding: 6rem 1.5rem 2.5rem;
    background-color: var(--color-primary);
    clip-path: circle(0% at calc(100% - 2.875rem) 2.375rem);
    pointer-events: none;
    transition: clip-path 0.7s var(--ease-out-expo);
  }

  .mobile-navigation.open {
    clip-path: circle(150% at calc(100% - 2.875rem) 2.375rem);
    pointer-events: auto;
  }

  .mobile-navigation-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-navigation-item {
    border-top: 1px solid rgba(10, 10, 10, 0.2);
  }

  .mobile-navigation-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 11vw, 3.5rem);
    line-height: 1.1;
    color: var(--color-black);
  }

  .mobile-navigation-index {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .mobile-locale-switch {
    display: flex;
    gap: 0.5rem;
  }

  .mobile-locale-switch .locale-link {
    font-size: 1rem;
    padding: 0.6rem 1rem;
    color: var(--color-black);
    border: 1px solid rgba(10, 10, 10, 0.3);
  }

  .mobile-locale-switch .locale-link.active {
    background: var(--color-black);
    color: var(--color-primary);
  }
</style>

<script>
  import gsap from "gsap"

  document.addEventListener("DOMContentLoaded", () => {

    let mobileMenuOpen = false
    let isScrolling = false

    const links = document.querySelectorAll<HTMLAnchorElement>(".navigation-link")
    const indicator = document.querySelector<HTMLElement>(".navigation-indicator")
    const mobileButton = document.querySelector<HTMLButtonElement>(".mobile-menu-button")
    const mobileMenu = document.querySelector<HTMLElement>(".mobile-navigation")
    const hamburger = document.querySelector<HTMLElement>(".hamburger")

    const sectionIds = ["#banner", "#works", "#services", "#about", "#contact"]

    const isHome = /^\/(es|en)\/?$/.test(window.location.pathname)
    const basePath = window.location.pathname.startsWith("/en") ? "/en" : "/es"

    /* -----------------------
      Active link + indicator
    ----------------------- */

    const setActive = (target: string, animate = true) => {
      links.forEach(link => {
        const isActive = link.getAttribute("href") === target
        link.classList.toggle("navigation-link-active", isActive)
        link.classList.toggle("navigation-link-inactive", !isActive)

        if (isActive && indicator) {
          const { offsetLeft, offsetWidth } = link
          const vars = { x: offsetLeft - 5, width: offsetWidth, opacity: 1 }
          animate
            ? gsap.to(indicator, { ...vars, duration: 0.45, ease: "power3.out" })
            : gsap.set(indicator, vars)
        }
      })
    }

    const scrollToSection = (target: string) => {
      const section = document.querySelector<HTMLElement>(target)
      if (!section) return

      isScrolling = true
      setActive(target)
      section.scrollIntoView({ behavior: "smooth", block: "start" })
      history.replaceState(null, "", window.location.pathname)
      setTimeout(() => { isScrolling = false }, 900)
    }

    const goToSection = (target: string) => {
      if (!isHome) {
        window.location.href = `${basePath}?section=${target.replace("#", "")}`
        return
      }
      scrollToSection(target)
    }

    /* -----------------------
      Header intro animation
    ----------------------- */

    gsap.from(".header > :not(.mobile-navigation)", { y: -40, opacity: 0, duration: 0.8, stagger: 0.08, ease: "power3.out" })

    /* -----------------------
      Initial state
    ----------------------- */

    setActive(isHome ? "#banner" : "#works", false)

    const params = new URLSearchParams(window.location.search)
    const targetSection = params.get("section")

    if (targetSection) {
      history.replaceState(null, "", window.location.pathname)
      setTimeout(() => scrollToSection(`#${targetSection}`), 100)
    }

    /* -----------------------
      Click navigation
    ----------------------- */

    links.forEach(link => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        const target = link.getAttribute("href")
        if (target) goToSection(target)
      })
    })

    /* -----------------------
      Locale switch
    ----------------------- */

    document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const targetLocale = link.getAttribute('data-locale')
        if (!targetLocale) return

        const currentPath = window.location.pathname

        // Rutas sin prefijo de idioma reconocido van a la raíz del locale
        window.location.href = /^\/(es|en)(\/|$)/.test(currentPath)
          ? currentPath
              .replace(/^\/(es|en)/, `/${targetLocale}`)
              .replace(/\/(privacy|privacidad)\/?$/, targetLocale === 'en' ? '/privacy' : '/privacidad')
          : `/${targetLocale}`
      })
    })

    /* -----------------------
      Section observer
    ----------------------- */

    if (isHome) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !isScrolling) setActive(`#${entry.target.id}`)
        })
      }, { rootMargin: "-45% 0px -50% 0px" })

      sectionIds.forEach(id => {
        const el = document.querySelector(id)
        if (el) observer.observe(el)
      })
    }

    /* -----------------------
      Mobile menu
    ----------------------- */

    const closeMobileMenu = () => {
      mobileMenuOpen = false
      mobileMenu?.classList.remove("open")
      hamburger?.classList.remove("open")
      mobileButton?.setAttribute("aria-expanded", "false")
      document.body.style.overflow = ""
    }

    mobileButton?.addEventListener("click", () => {
      mobileMenuOpen = !mobileMenuOpen
      mobileMenu?.classList.toggle("open", mobileMenuOpen)
      hamburger?.classList.toggle("open", mobileMenuOpen)
      mobileButton.setAttribute("aria-expanded", mobileMenuOpen.toString())
      document.body.style.overflow = mobileMenuOpen ? "hidden" : ""
    })

    document.querySelectorAll<HTMLAnchorElement>(".mobile-navigation-link").forEach(link => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        closeMobileMenu()
        const target = link.getAttribute("href")
        if (target) goToSection(target)
      })
    })
  })
</script>
