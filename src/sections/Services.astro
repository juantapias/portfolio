---
import type { IServices } from '../types'
import { useTranslations } from '../utils/i18n'

const locale = Astro.currentLocale as 'es' | 'en'
const t = useTranslations(locale)

const services = t('Works.services') as unknown as IServices[]
---

<section
  id='services'
  class='px-4 md:px-6 lg:px-10 py-24 md:py-32'
  aria-labelledby='services-title'>
  <div class='grid gap-8 lg:grid-cols-[1fr_2fr] mb-14 md:mb-20 px-2'>
    <span class='eyebrow text-accent services-reveal'>{t('Services.eyebrow')}</span>
    <h2
      id='services-title'
      class='services-reveal text-white uppercase leading-[0.9] text-[clamp(3rem,9vw,9rem)]'>
      {t('Services.title')}
    </h2>
  </div>

  <ol class='border-b border-white/10'>
    {services.map((service, index) => (
      <li class='service-row group'>
        <span class='service-index'>{String(index + 1).padStart(2, '0')}</span>
        <h3 class='service-label'>{service.label}</h3>
        <div class='service-body'>
          <p class='text-white/80 leading-relaxed'>{service.description}</p>
          <p class='mt-3 text-sm leading-relaxed text-white/45'>{service.features}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .service-row {
    position: relative;
    display: grid;
    gap: 0.75rem 2rem;
    padding: 2rem 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    isolation: isolate;
  }

  .service-row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-primary);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-out-expo);
  }

  @media (min-width: 1024px) {
    .service-row {
      grid-template-columns: 4rem 1.2fr 1fr;
      align-items: start;
      padding: 2.5rem 1rem;
    }

    .service-row:hover::before {
      transform: scaleY(1);
    }

    .service-row:hover .service-index,
    .service-row:hover .service-label,
    .service-row:hover .service-body p {
      color: var(--color-black);
    }
  }

  .service-index {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    padding-top: 0.5rem;
    transition: color 0.3s ease;
  }

  .service-label {
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1;
    text-transform: uppercase;
    color: white;
    transition: color 0.3s ease;
  }

  .service-body p {
    transition: color 0.3s ease;
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector<HTMLElement>('#services')
    if (!section || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    gsap.from(section.querySelectorAll('.services-reveal'), {
      y: 60,
      opacity: 0,
      duration: 1,
      stagger: 0.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: section, start: 'top 75%' },
    })

    gsap.from(section.querySelectorAll('.service-row'), {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.08,
      ease: 'power3.out',
      scrollTrigger: { trigger: section.querySelector('ol'), start: 'top 80%' },
    })
  })
</script>
