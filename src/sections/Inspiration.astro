---
import { useTranslations } from '../utils/i18n'

const locale = Astro.currentLocale as 'es' | 'en'
const t = useTranslations(locale)

const labels = (t('Ads.tags') as unknown as string[]) ?? []

// Sticker look per tag: visual variant, tilt and position around the headline (md+).
const layout = [
  { variant: 'primary', rot: -8, pos: '--top:-11%;--left:4%' },
  { variant: 'cream', rot: 6, pos: '--top:-8%;--right:8%' },
  { variant: 'outline', rot: 4, pos: '--top:40%;--left:0' },
  { variant: 'dark', rot: -5, pos: '--top:47%;--right:0' },
  { variant: 'cream', rot: 9, pos: '--bottom:-12%;--left:14%' },
  { variant: 'primary', rot: -6, pos: '--bottom:-15%;--right:12%' },
]

const tags = labels.slice(0, layout.length).map((label, i) => ({ label, ...layout[i] }))
---

<section id='ads' class='h-svh relative overflow-hidden px-4 md:px-6 lg:px-10'>
  <div class='h-full flex items-center justify-center'>
    <div class='ads-stage'>
      <h2 class='ads-title text-3xl md:text-5xl lg:text-7xl xl:text-9xl text-center uppercase text-accent leading-none space-y-3 md:space-y-4 lg:space-y-6 flex flex-col items-center'>
        <span class='ads-line'>{t('Ads.line1')}</span>
        <span class='ads-line'>{t('Ads.line2')}</span>
        <span class='ads-line'>{t('Ads.line3')}</span>
      </h2>

      <ul class='ads-tags' role='list'>
        {tags.map(({ label, variant, rot, pos }) => (
          <li class={`ads-tag ads-tag--${variant}`} style={`--rot:${rot}deg;${pos}`}>
            <span class='ads-tag-dot' aria-hidden='true'></span>
            {label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ads-stage {
    position: relative;
  }

  /* Letters start as a faint ghost of the accent color until the scroll reveals them */
  #ads :global(.ads-char) {
    color: rgb(255 213 141 / 0.14);
    transform-origin: center center;
    will-change: transform, color;
  }

  /* ── Tags ─────────────────────────────────────────────
     Below lg: a wrapped row under the headline.
     lg+: stickers floating over the edges of the headline. */
  .ads-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 0.5rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .ads-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    rotate: var(--rot, 0deg);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.6);
  }

  .ads-tag-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: currentColor;
    flex-shrink: 0;
  }

  .ads-tag--primary {
    background: var(--color-primary);
    color: var(--color-black);
  }

  .ads-tag--cream {
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .ads-tag--cream .ads-tag-dot {
    background: var(--color-primary);
  }

  .ads-tag--outline {
    border: 1px solid var(--color-accent);
    background: rgb(10 10 10 / 0.6);
    color: var(--color-accent);
    backdrop-filter: blur(6px);
  }

  .ads-tag--dark {
    border: 1px solid rgb(255 255 255 / 0.12);
    background: var(--color-ink);
    color: var(--color-white);
  }

  .ads-tag--dark .ads-tag-dot {
    background: var(--color-primary);
    box-shadow: 0 0 0 4px rgb(245 141 36 / 0.25);
  }

  @media (min-width: 768px) {
    .ads-tags {
      gap: 1rem 0.75rem;
      margin-top: 3.5rem;
    }

    .ads-tag {
      padding: 0.7rem 1.25rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 1024px) {
    .ads-tags {
      position: absolute;
      inset: 0;
      margin: 0;
      display: block;
      pointer-events: none;
    }

    .ads-tag {
      position: absolute;
      top: var(--top, auto);
      right: var(--right, auto);
      bottom: var(--bottom, auto);
      left: var(--left, auto);
      z-index: 1;
      padding: 0.75rem 1.35rem;
      font-size: 1rem;
    }
  }

  @media (min-width: 1280px) {
    .ads-tag {
      padding: 0.9rem 1.6rem;
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ads :global(.ads-char) {
      color: inherit;
    }
  }
</style>

<script>
  import gsap from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"
  import { SplitText } from "gsap/SplitText"

  gsap.registerPlugin(ScrollTrigger, SplitText)

  const PEAK = "#f58d24" // --color-primary
  const SETTLE = "#ffd58d" // --color-accent

  const initAds = () => {
    const section = document.querySelector<HTMLElement>("#ads")
    const title = section?.querySelector<HTMLElement>(".ads-title")
    if (!section || !title) return

    const tags = gsap.utils.toArray<HTMLElement>(".ads-tag", section)
    const mm = gsap.matchMedia()

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // words keep each word on one line; chars are what we animate
      const split = new SplitText(title.querySelectorAll(".ads-line"), {
        type: "words,chars",
        charsClass: "ads-char",
      })
      const chars = split.chars
      const total = chars.length

      gsap.set(tags, { autoAlpha: 0, scale: 0.6, y: 30 })

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: () => `+=${window.innerWidth < 992 ? window.innerHeight * 1.4 : window.innerHeight * 2}`,
          pin: true,
          scrub: 0.8,
          invalidateOnRefresh: true,
        },
      })

      // Each letter lights up in sequence: pops to the primary color with a slight tilt,
      // then settles back to the accent color at its normal size.
      const span = 85
      const step = 3.5
      chars.forEach((char, i) => {
        const at = (i / total) * span
        tl.to(char, {
          color: PEAK,
          scale: 1.12,
          rotation: () => gsap.utils.random(-4, 4),
          duration: step,
          ease: "power1.out",
        }, at)
        tl.to(char, {
          color: SETTLE,
          scale: 1,
          rotation: 0,
          duration: step,
          ease: "power1.inOut",
        }, at + step)
      })

      // Tags pop in one by one while the sentence is being revealed
      tags.forEach((tag, i) => {
        tl.to(tag, {
          autoAlpha: 1,
          scale: 1,
          y: 0,
          duration: 6,
          ease: "back.out(2)",
        }, 6 + (i / Math.max(tags.length - 1, 1)) * (span - 6))
      })

      return () => split.revert()
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAds)
  } else {
    initAds()
  }
</script>
