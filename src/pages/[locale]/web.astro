---
/**
 * Landing de captación para campañas pagadas (Meta / Instagram y Google Ads).
 * URL: /es/web/ y /en/web/
 *
 * - Sin Header/Footer del sitio: un solo objetivo (pedir propuesta), sin fugas.
 * - noindex: es tráfico pagado; no debe competir en Google con la home.
 * - Guarda los UTMs / gclid / fbclid al aterrizar y los adjunta al mensaje de WhatsApp.
 * - Animaciones con el mismo lenguaje GSAP del home (ver <script> al final), sin
 *   secciones fijadas (pin) para no frenar a quien viene de un anuncio.
 */
import Layout from '../../layouts/layout-blank.astro'
import LeadForm from '../../components/landing/LeadForm.astro'
import { projects } from '../../data/projects'
import { useTranslations } from '../../utils/i18n'
import { cloudinaryImage, formatDuration, resolveProjectView } from '../../utils/project'

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }]
}

const locale = Astro.params.locale as 'es' | 'en'
const t = useTranslations(locale)

const WHATSAPP = '573332384866'
const whatsappUrl = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t('Landing.form.message.greeting') as string)}`

const featuredSlugs = ['pacific-waves-hostel-and-surf', 'menuestro', 'diagnostico-cic', '404-studio']
const featured = featuredSlugs
  .map(slug => projects.find(p => p.slug === slug))
  .filter(p => p !== undefined)
  .map(p => resolveProjectView(p, locale))

const brands = [
  { src: '/images/brands/menuestro-logo.webp', alt: 'Menuestro' },
  { src: '/images/brands/cic-logo.webp', alt: 'Diagnóstico CIC' },
  { src: '/images/brands/danez-logo.webp', alt: 'Química Danez' },
  { src: '/images/brands/diana-moncada-logo.webp', alt: 'Diana Moncada' },
  { src: '/images/brands/ingenor-logo.webp', alt: 'Ingenor' },
  { src: '/images/brands/pacific-waves-logo.webp', alt: 'Pacific Waves Hostel & Surf' },
  { src: '/images/brands/mindsett-logo.webp', alt: 'Mindsett' },
  { src: '/images/brands/404-studio-logo.webp', alt: '404 Studio' },
]
// Igual que en Brands.astro: varias copias para que el bucle ligado al scroll nunca se quede sin logos
const BRAND_SETS = 6

const proof = t('Landing.hero.proof') as unknown as string[]
const pains = t('Landing.pains.items') as unknown as string[]
const benefits = t('Landing.benefits.items') as unknown as { title: string; text: string }[]
const steps = t('Landing.process.steps') as unknown as { title: string; text: string }[]
const faqs = t('Landing.faq.items') as unknown as { q: string; a: string }[]

const benefitIcons = [
  'M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z',
  'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2ZM11 18h2',
  'M13 2 3 14h9l-1 8 10-12h-9l1-8Z',
  'm21 21-4.3-4.3M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z',
  'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z',
  'M3 3v18h18M7 15l4-4 3 3 5-6',
]

const homeHref = `/${locale}/`
const privacyHref = locale === 'es' ? '/es/privacidad/' : '/en/privacy/'
---

<Layout
  title={`${t('Landing.seo.title')} — Tapias`}
  description={t('Landing.seo.description')}
  lang={locale}
  ogImage='/images/og-image.jpg'
  noindex>
  <link rel='preload' as='image' href='/images/banner.jpg' slot='head' />
  <!--
    Oculta el contenido del hero antes del primer pintado solo si habrá animación.
    Si GSAP no llega a cargar, a los 2,5 s se muestra igual (no se pierde el mensaje).
  -->
  <script is:inline slot='head'>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('lp-motion')
      setTimeout(function () {
        if (!window.__lpMotionReady) document.documentElement.classList.remove('lp-motion')
      }, 2500)
    }
  </script>

  <!-- Barra superior: marca + un único CTA -->
  <header class='lp-top'>
    <a href={homeHref} class='lp-intro font-primary text-2xl uppercase tracking-wider text-white' aria-label='Tapias'>
      Tapias
    </a>
    <a href='#propuesta' class='lp-intro btn primary small' data-cta='top'>{t('Landing.topCta')}</a>
  </header>

  <!-- 1. Hero: promesa + CTA -->
  <section id='lp-hero' class='lp-hero' aria-labelledby='lp-title'>
    <div class='lp-hero-bg' aria-hidden='true'></div>
    <div class='lp-hero-inner'>
      <span class='lp-intro eyebrow text-white/80'>{t('Landing.hero.eyebrow')}</span>
      <h1 id='lp-title' class='lp-title'>
        <span class='lp-title-line'><span class='lp-title-text'>{t('Landing.hero.line1')}</span></span>
        <span class='lp-title-line'><span class='lp-title-text text-primary'>{t('Landing.hero.line2')}</span></span>
        <span class='lp-title-line'><span class='lp-title-text lp-title-outline'>{t('Landing.hero.line3')}</span></span>
      </h1>
      <p class='lp-intro lp-subtitle'>{t('Landing.hero.subtitle')}</p>

      <div class='lp-intro lp-actions'>
        <a href='#propuesta' class='btn primary arrow' data-cta='hero'>
          {t('Landing.hero.cta')}
          <span class='btn-arrow-icon' aria-hidden='true'>
            <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 5v14M19 12l-7 7-7-7'/></svg>
          </span>
        </a>
        <a href={whatsappUrl} target='_blank' rel='noopener noreferrer' class='btn outline'>
          {t('Landing.hero.ctaAlt')}
        </a>
      </div>

      <ul class='lp-proof'>
        {proof.map(item => (
          <li class='lp-intro'>
            <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12l5 5L20 7'/></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. Prueba social: logos que avanzan con el scroll (como en el home) -->
  <section id='lp-logos' class='py-12 md:py-16 border-y border-white/10 overflow-hidden' aria-labelledby='lp-logos-title'>
    <h2 id='lp-logos-title' class='eyebrow text-accent px-4 md:px-6 lg:px-10' data-rise>{t('Landing.logos')}</h2>
    <div class='lp-marquee mt-8'>
      <ul class='lp-marquee-track' data-set-size={brands.length}>
        {Array.from({ length: BRAND_SETS }, (_, set) => brands.map(brand => (
          <li class='lp-brand' aria-hidden={set === 0 ? undefined : 'true'}>
            <img src={brand.src} alt={set === 0 ? brand.alt : ''} loading='lazy' decoding='async' height='40' />
          </li>
        )))}
      </ul>
    </div>
  </section>

  <!-- 3. Problema -->
  <section id='lp-pains' class='lp-section' aria-labelledby='lp-pains-title'>
    <div class='lp-head'>
      <span class='eyebrow text-accent' data-rise>{t('Landing.pains.eyebrow')}</span>
      <h2 id='lp-pains-title' class='lp-h2' data-split>{t('Landing.pains.title')}</h2>
    </div>
    <ul class='grid gap-3 md:grid-cols-2' data-stagger>
      {pains.map(pain => (
        <li class='lp-pain'>
          <span class='lp-pain-x' aria-hidden='true' data-pop>
            <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round'><path d='M18 6 6 18M6 6l12 12'/></svg>
          </span>
          <span class='lp-pain-text'>{pain}</span>
        </li>
      ))}
    </ul>
    <p class='lp-closing' data-glow>
      {t('Landing.pains.closing')}
    </p>
  </section>

  <!-- 4. Solución / beneficios -->
  <section id='lp-benefits' class='lp-section lp-cream' aria-labelledby='lp-benefits-title'>
    <div class='lp-head'>
      <span class='eyebrow text-secondary' data-rise>{t('Landing.benefits.eyebrow')}</span>
      <h2 id='lp-benefits-title' class='lp-h2' data-split>{t('Landing.benefits.title')}</h2>
    </div>
    <ul class='grid gap-4 sm:grid-cols-2 lg:grid-cols-3' data-stagger>
      {benefits.map((item, index) => (
        <li class='lp-benefit'>
          <span class='lp-benefit-icon' aria-hidden='true' data-pop>
            <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d={benefitIcons[index]} /></svg>
          </span>
          <h3 class='text-2xl text-ink'>{item.title}</h3>
          <p class='text-ink/70 leading-relaxed'>{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5. Casos reales -->
  <section id='lp-work' class='lp-section' aria-labelledby='lp-work-title'>
    <div class='lp-head'>
      <span class='eyebrow text-accent' data-rise>{t('Landing.work.eyebrow')}</span>
      <h2 id='lp-work-title' class='lp-h2' data-split>{t('Landing.work.title')}</h2>
    </div>
    <ul class='grid gap-6 md:grid-cols-2'>
      {featured.map(project => (
        <li class='lp-case-item'>
          <a
            href={`/${locale}/projects/${project.slug}/`}
            target='_blank'
            rel='noopener'
            class='lp-case group'>
            <div class='lp-case-media'>
              <img
                src={cloudinaryImage(project.coverImage, 1200)}
                alt={project.coverAlt}
                loading='lazy'
                decoding='async'
                width='1200'
                height='750'
                style={{ objectPosition: project.coverPosition ?? 'center' }} />
            </div>
            <div class='flex items-end justify-between gap-4 pt-4'>
              <div>
                <h3 class='text-2xl md:text-3xl text-white'>{project.name}</h3>
                <p class='mt-1 text-sm text-white/55'>
                  {project.industry} · {project.country} · {formatDuration(project.durationWeeks, locale)}
                </p>
              </div>
              <span class='lp-case-link'>
                {t('Landing.work.viewCase')}
                <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17 17 7M8 7h9v9'/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <div class='mt-12 flex justify-center' data-rise>
      <a href='#propuesta' class='btn default arrow' data-cta='work'>
        {t('Landing.work.cta')}
        <span class='btn-arrow-icon' aria-hidden='true'>
          <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 5v14M19 12l-7 7-7-7'/></svg>
        </span>
      </a>
    </div>
    <!-- Burbuja "Ver caso" que sigue al cursor (como en el home) -->
    <div class='lp-cursor' aria-hidden='true'>
      <span>{t('Landing.work.viewCase')}</span>
    </div>
  </section>

  <!-- 6. Proceso -->
  <section id='lp-process' class='lp-section border-t border-white/10' aria-labelledby='lp-process-title'>
    <div class='lp-head'>
      <span class='eyebrow text-accent' data-rise>{t('Landing.process.eyebrow')}</span>
      <h2 id='lp-process-title' class='lp-h2' data-split>{t('Landing.process.title')}</h2>
    </div>
    <div class='lp-process-track' aria-hidden='true'><span class='lp-process-progress'></span></div>
    <ol class='grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 md:grid-cols-2 lg:grid-cols-4' data-stagger>
      {steps.map((item, index) => (
        <li class='bg-black p-6 md:p-8'>
          <span class='inline-block font-primary text-5xl text-primary' data-pop>{String(index + 1).padStart(2, '0')}</span>
          <h3 class='mt-6 text-2xl text-white'>{item.title}</h3>
          <p class='mt-2 text-white/65 leading-relaxed'>{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 7. Formulario de calificación -->
  <section id='propuesta' class='lp-section lp-form-section' aria-labelledby='lp-form-title'>
    <div class='grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:items-start'>
      <div class='lg:sticky lg:top-28'>
        <span class='eyebrow text-accent' data-rise>{t('Landing.form.eyebrow')}</span>
        <h2 id='lp-form-title' class='lp-h2 mt-6' data-split>{t('Landing.form.title')}</h2>
        <p class='mt-4 max-w-md text-lg text-white/70 leading-relaxed' data-rise>{t('Landing.form.subtitle')}</p>
        <div class='mt-8 flex items-center gap-4' data-rise>
          <img
            src='/images/juan-tapias.jpg'
            alt='Juan Tapias'
            width='64'
            height='64'
            loading='lazy'
            class='h-16 w-16 rounded-full object-cover border-2 border-primary' />
          <div>
            <p class='text-white font-medium'>Juan Tapias</p>
            <p class='text-sm text-white/55'>{t('Landing.hero.eyebrow')}</p>
          </div>
        </div>
      </div>
      <div data-clip>
        <LeadForm locale={locale} phone={WHATSAPP} />
      </div>
    </div>
  </section>

  <!-- 8. Objeciones -->
  <section id='lp-faq' class='lp-section border-t border-white/10' aria-labelledby='lp-faq-title'>
    <div class='grid gap-10 lg:grid-cols-[1fr_2fr]'>
      <div>
        <span class='eyebrow text-accent' data-rise>{t('Landing.faq.eyebrow')}</span>
        <h2 id='lp-faq-title' class='lp-h2 mt-6' data-split>{t('Landing.faq.title')}</h2>
      </div>
      <div class='border-t border-white/10' data-stagger>
        {faqs.map((item, index) => (
          <details class='lp-faq' open={index === 0}>
            <summary>
              <h3>{item.q}</h3>
              <span class='lp-faq-icon' aria-hidden='true'></span>
            </summary>
            <div class='lp-faq-panel'>
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. CTA final -->
  <section id='lp-final' class='lp-final' aria-labelledby='lp-final-title'>
    <h2 id='lp-final-title' class='lp-final-title' data-split>{t('Landing.final.title')}</h2>
    <p class='mt-5 text-lg text-black/75' data-rise>{t('Landing.final.text')}</p>
    <div class='mt-10 flex flex-col sm:flex-row gap-3 justify-center' data-rise>
      <a href='#propuesta' class='btn dark' data-cta='final'>{t('Landing.final.cta')}</a>
      <a href={whatsappUrl} target='_blank' rel='noopener noreferrer' class='btn lp-btn-ghost'>
        {t('Landing.hero.ctaAlt')}
      </a>
    </div>
  </section>

  <footer class='lp-footer'>
    <span>© {new Date().getFullYear()} Tapias</span>
    <nav class='flex gap-5'>
      <a href={homeHref}>{t('Landing.footer.portfolio')}</a>
      <a href={privacyHref}>{t('Landing.footer.privacy')}</a>
      <button type='button' data-cookie-settings>{t('Cookies.settings')}</button>
    </nav>
  </footer>

  <!-- CTA fijo en móvil -->
  <div class='lp-sticky' data-sticky slot='after'>
    <a href='#propuesta' class='btn primary w-full' data-cta='sticky'>{t('Landing.sticky')}</a>
  </div>
</Layout>

<style>
  /* Estado previo a la intro (solo con animación activa, ver script en <head>) */
  :global(html.lp-motion) .lp-intro,
  :global(html.lp-motion) .lp-title-text {
    opacity: 0;
  }

  /* Barra superior */
  .lp-top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem;
    background: rgb(10 10 10 / 0.6);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  @media (min-width: 1024px) {
    .lp-top {
      padding: 1rem 2.5rem;
    }
  }

  /* Hero */
  .lp-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding: 7rem 1rem 3rem;
  }

  @media (min-width: 1024px) {
    .lp-hero {
      padding: 8rem 2.5rem 4rem;
    }
  }

  .lp-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to bottom, rgb(10 10 10 / 0.55) 0%, rgb(10 10 10 / 0.45) 40%, rgb(10 10 10 / 0.95) 100%),
      url('/images/banner.jpg');
    background-position: 50% 35%;
    background-size: cover;
    will-change: transform;
  }

  .lp-hero-inner {
    max-width: 64rem;
  }

  .lp-title {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 8vw, 7rem);
    line-height: 0.95;
    color: white;
  }

  /* Cada línea es una máscara: las letras suben desde abajo (como "Tapias" en el home) */
  .lp-title-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .lp-title-text {
    display: inline-block;
  }

  .lp-title-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px white;
  }

  @media (min-width: 768px) {
    .lp-title-outline {
      -webkit-text-stroke-width: 2px;
    }
  }

  .lp-subtitle {
    max-width: 38rem;
    margin-top: 1.75rem;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.85);
  }

  .lp-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 640px) {
    .lp-actions {
      flex-direction: row;
    }
  }

  .lp-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.75);
  }

  .lp-proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lp-proof svg {
    color: var(--color-primary);
  }

  /* Títulos de sección: SplitText envuelve cada línea en .lp-line-mask */
  :global(.lp-line-mask) {
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  /* Logos */
  .lp-marquee {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .lp-marquee-track {
    display: flex;
    align-items: center;
    gap: 4rem;
    width: max-content;
  }

  .lp-brand img {
    height: 2.5rem;
    width: auto;
    opacity: 0.7;
    filter: grayscale(1) brightness(1.6);
  }

  /* Secciones */
  .lp-section {
    padding: 5rem 1rem;
  }

  @media (min-width: 768px) {
    .lp-section {
      padding: 7rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .lp-section {
      padding: 8rem 2.5rem;
    }
  }

  .lp-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 1024px) {
    .lp-head {
      grid-template-columns: 1fr 2fr;
      margin-bottom: 4rem;
    }
  }

  .lp-h2 {
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    line-height: 0.95;
    color: white;
  }

  /* Bloque crema que se monta sobre el anterior, como "Trabajos" en el home */
  .lp-cream {
    position: relative;
    z-index: 1;
    margin-top: -2.5rem;
    border-radius: 2rem 2rem 0 0;
    background: var(--color-cream);
  }

  @media (min-width: 768px) {
    .lp-cream {
      border-radius: 3rem 3rem 0 0;
    }
  }

  .lp-cream .lp-h2 {
    color: var(--color-ink);
  }

  .lp-cream .eyebrow::before {
    background: var(--color-secondary);
  }

  /* Dolores: en escritorio se pintan de naranja al pasar el ratón (como Servicios) */
  .lp-pain {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.85);
  }

  .lp-pain::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-primary);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .lp-pain-text {
    transition: color 0.3s ease;
  }

  .lp-pain-x {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    padding: 0.375rem;
    border-radius: 9999px;
    background: rgb(245 141 36 / 0.15);
    color: var(--color-primary);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  @media (hover: hover) and (min-width: 1024px) {
    .lp-pain:hover::before {
      transform: scaleY(1);
    }

    .lp-pain:hover .lp-pain-text {
      color: var(--color-black);
    }

    .lp-pain:hover .lp-pain-x {
      background: var(--color-black);
      color: var(--color-primary);
    }
  }

  .lp-closing {
    max-width: 48rem;
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
    color: var(--color-accent);
  }

  /* Beneficios */
  .lp-benefit {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem;
    border-radius: 1.25rem;
    background: white;
    box-shadow: 0 1px 0 rgb(20 18 16 / 0.06);
  }

  .lp-benefit-icon {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.5rem;
    padding: 0.75rem;
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-ink);
  }

  /* Casos */
  .lp-case {
    display: block;
  }

  .lp-case-media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 1.25rem;
    background: var(--color-darkGray);
  }

  .lp-case-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .lp-case:hover .lp-case-media img {
    transform: scale(1.04);
  }

  .lp-case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--color-accent);
  }

  .lp-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    display: none;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .lp-cursor {
      display: block;
    }

    .lp-case-media {
      cursor: none;
    }
  }

  .lp-cursor span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    height: 6.5rem;
    margin: -3.25rem 0 0 -3.25rem;
    border-radius: 9999px;
    background: var(--color-primary);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    transform: scale(0);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .lp-cursor.is-visible span {
    transform: scale(1);
  }

  /* Proceso: barra que se llena con el scroll */
  .lp-process-track {
    height: 3px;
    margin-bottom: 1.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }

  .lp-process-progress {
    display: block;
    height: 100%;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Formulario */
  .lp-form-section {
    background:
      radial-gradient(60rem 30rem at 85% 0%, rgb(245 141 36 / 0.14), transparent 60%),
      var(--color-black);
    scroll-margin-top: 4rem;
  }

  /* FAQ */
  .lp-faq {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .lp-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0.25rem;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .lp-faq summary::-webkit-details-marker {
    display: none;
  }

  /* La pregunta abierta no se puede cerrar (siempre hay una abierta) */
  .lp-faq.is-open summary {
    cursor: default;
  }

  .lp-faq h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    color: white;
    transition: color 0.3s ease;
  }

  .lp-faq summary:hover h3,
  .lp-faq.is-open h3 {
    color: var(--color-accent);
  }

  .lp-faq-panel {
    overflow: hidden;
  }

  .lp-faq-panel p {
    padding: 0 0.25rem 1.75rem;
    max-width: 44rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.7);
  }

  .lp-faq-icon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .lp-faq-icon::before,
  .lp-faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    background: var(--color-primary);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .lp-faq-icon::after {
    transform: rotate(90deg);
  }

  .lp-faq.is-open .lp-faq-icon::after {
    transform: rotate(0);
  }

  /* CTA final */
  .lp-final {
    padding: 6rem 1rem;
    text-align: center;
    background: var(--color-primary);
    color: var(--color-black);
  }

  @media (min-width: 1024px) {
    .lp-final {
      padding: 9rem 2.5rem;
    }
  }

  .lp-final-title {
    max-width: 56rem;
    margin: 0 auto;
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 0.95;
  }

  .lp-btn-ghost {
    border: 1px solid rgb(10 10 10 / 0.5);
    color: var(--color-black);
  }

  .lp-btn-ghost:hover {
    background: var(--color-black);
    color: var(--color-primary);
  }

  .lp-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 1rem 6rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.5);
  }

  @media (min-width: 768px) {
    .lp-footer {
      padding: 2rem 2.5rem;
    }
  }

  .lp-footer a:hover,
  .lp-footer button:hover {
    color: white;
  }

  .lp-footer button {
    cursor: pointer;
  }

  /* CTA fijo en móvil: aparece al pasar el hero y se oculta en el formulario */
  .lp-sticky {
    position: fixed;
    inset: auto 0 0;
    z-index: 30;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: linear-gradient(to top, rgb(10 10 10 / 0.95) 60%, transparent);
    transform: translateY(110%);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .lp-sticky.is-visible {
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .lp-sticky {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-marquee-track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }

    .lp-brand[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<!-- Tracking del embudo (independiente de las animaciones) -->
<script>
  // 1. Guarda el origen del anuncio (UTMs, gclid, fbclid) para adjuntarlo al lead
  try {
    const params = new URLSearchParams(window.location.search)
    const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid']
    const found = Object.fromEntries(keys.filter(k => params.get(k)).map(k => [k, params.get(k)!]))
    if (Object.keys(found).length) sessionStorage.setItem('lp-source', JSON.stringify(found))
  } catch {}

  const track = (event: string, params: Record<string, unknown> = {}) => {
    const w = window as any
    if (typeof w.gtag === 'function') w.gtag('event', event, params)
  }

  // 2. Clics en CTAs internos (miden qué bloque empuja más al formulario)
  document.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach(link => {
    link.addEventListener('click', () => track('cta_click', { cta_location: link.dataset.cta }))
  })

  // 3. WhatsApp directo: Analytics.astro ya envía generate_lead a GA4; aquí solo el Lead de Meta
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"]:not([data-no-track])').forEach(link => {
    link.addEventListener('click', () => {
      const fbq = (window as any).fbq
      if (typeof fbq === 'function') fbq('track', 'Lead', { method: 'whatsapp' })
    })
  })

  // 4. CTA fijo en móvil: visible tras el hero, oculto mientras se ve el formulario
  const sticky = document.querySelector<HTMLElement>('[data-sticky]')
  const hero = document.getElementById('lp-hero')
  const formSection = document.getElementById('propuesta')
  if (sticky && hero && formSection && 'IntersectionObserver' in window) {
    let heroVisible = true
    let formVisible = false
    const update = () => sticky.classList.toggle('is-visible', !heroVisible && !formVisible)
    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting
      update()
    }).observe(hero)
    new IntersectionObserver(([entry]) => {
      formVisible = entry.isIntersecting
      update()
    }, { threshold: 0.15 }).observe(formSection)
  }

  // 5. Profundidad de scroll: cuánta gente llega a cada bloque del embudo
  if ('IntersectionObserver' in window) {
    const seen = new Set<string>()
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const id = entry.target.id
        if (entry.isIntersecting && !seen.has(id)) {
          seen.add(id)
          track('lp_section_view', { section: id })
          io.unobserve(entry.target)
        }
      })
    }, { rootMargin: '0px 0px -50% 0px' })
    document.querySelectorAll('main section[id]').forEach(s => io.observe(s))
  }
</script>

<!-- Animaciones: mismo lenguaje GSAP que el home -->
<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'

  gsap.registerPlugin(ScrollTrigger, SplitText)

  const PEAK = '#f58d24' // --color-primary
  const SETTLE = '#ffd58d' // --color-accent

  const root = document.documentElement
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches
  ;(window as any).__lpMotionReady = true

  /* ── FAQ: acordeón animado, siempre una pregunta abierta (como en el home) ── */
  const initFaq = () => {
    const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('.lp-faq'))
    const running = new Map<HTMLDetailsElement, gsap.core.Timeline>()
    const DURATION = 0.5
    const EASE = 'power3.inOut'

    const animate = (item: HTMLDetailsElement, opening: boolean) => {
      const panel = item.querySelector<HTMLElement>('.lp-faq-panel')!
      const answer = panel.firstElementChild as HTMLElement
      const from = item.open ? panel.offsetHeight : 0

      running.get(item)?.kill()
      item.classList.toggle('is-open', opening)
      if (opening) item.open = true

      if (reduceMotion) {
        item.open = opening
        return
      }

      const tl = gsap.timeline({
        onComplete: () => {
          if (!opening) item.open = false
          gsap.set([panel, answer], { clearProps: 'all' })
          running.delete(item)
        },
      })

      if (opening) {
        tl.fromTo(panel, { height: from }, { height: 'auto', duration: DURATION, ease: EASE }, 0)
          .fromTo(answer, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'power2.out' }, DURATION * 0.35)
      } else {
        tl.fromTo(panel, { height: from }, { height: 0, duration: DURATION, ease: EASE }, 0)
          .to(answer, { autoAlpha: 0, y: -6, duration: 0.2, ease: 'power2.in' }, 0)
      }

      running.set(item, tl)
    }

    if (!items.some(item => item.open) && items[0]) items[0].open = true
    items.forEach(item => item.classList.toggle('is-open', item.open))

    items.forEach(item => {
      item.querySelector('summary')!.addEventListener('click', event => {
        event.preventDefault()
        if (item.classList.contains('is-open')) return
        items.filter(other => other.classList.contains('is-open')).forEach(other => animate(other, false))
        animate(item, true)
        window.setTimeout(() => ScrollTrigger.refresh(), reduceMotion ? 60 : DURATION * 1000 + 60)
      })
    })
  }

  /* ── Cursor "Ver caso" sobre las portadas ── */
  const initCursor = () => {
    const cursor = document.querySelector<HTMLElement>('.lp-cursor')
    if (!cursor || !canHover) return

    const xTo = gsap.quickTo(cursor, 'x', { duration: 0.5, ease: 'power3' })
    const yTo = gsap.quickTo(cursor, 'y', { duration: 0.5, ease: 'power3' })

    window.addEventListener('mousemove', e => {
      xTo(e.clientX)
      yTo(e.clientY)
    })

    document.querySelectorAll<HTMLElement>('.lp-case-media').forEach(media => {
      media.addEventListener('mouseenter', () => cursor.classList.add('is-visible'))
      media.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'))
    })
  }

  /* ── Hero: intro letra a letra + el título se aleja con el scroll ── */
  const initHero = () => {
    const hero = document.getElementById('lp-hero')!
    const bg = hero.querySelector<HTMLElement>('.lp-hero-bg')!
    const texts = gsap.utils.toArray<HTMLElement>('.lp-title-text', hero)
    const intro = gsap.utils.toArray<HTMLElement>('.lp-intro')

    const split = SplitText.create(texts, { type: 'words,chars', charsClass: 'lp-char' })

    // GSAP toma el control del estado inicial y retiramos el ocultado por CSS
    gsap.set(intro, { opacity: 0, y: 24 })
    gsap.set(texts, { opacity: 1 })
    gsap.set(split.chars, { yPercent: 110 })
    root.classList.remove('lp-motion')

    // Scroll: las letras se elevan y se desvanecen, la imagen hace parallax.
    // Se crea al terminar la intro (como en el home) para que no se pisen.
    const initScroll = () => {
      const scrub = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true }
      gsap.to(split.chars, { yPercent: -40, opacity: 0, stagger: 0.004, ease: 'none', scrollTrigger: scrub })
      gsap.to(bg, { yPercent: 18, ease: 'none', scrollTrigger: { ...scrub } })
    }

    gsap.timeline({ defaults: { ease: 'power3.out' }, onComplete: initScroll })
      .from(bg, { scale: 1.12, duration: 1.8, ease: 'power2.out' }, 0)
      .to('.lp-top .lp-intro', { opacity: 1, y: 0, duration: 0.8, stagger: 0.08 }, 0)
      .to('#lp-hero .eyebrow', { opacity: 1, y: 0, duration: 0.6 }, 0.1)
      .to(split.chars, { yPercent: 0, duration: 0.9, stagger: 0.018 }, 0.2)
      .to('#lp-hero .lp-intro:not(.eyebrow)', { opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'power2.out' }, '-=0.5')
  }

  /* ── Logos: entran y avanzan ligados al scroll (como Brands.astro) ── */
  const initLogos = () => {
    const section = document.getElementById('lp-logos')!
    const track = section.querySelector<HTMLElement>('.lp-marquee-track')!
    const items = section.querySelectorAll<HTMLElement>('.lp-brand')
    const setSize = Number(track.dataset.setSize) || 1
    let setWidth = 0

    gsap.from(items, {
      opacity: 0,
      y: 40,
      scale: 0.9,
      stagger: 0.03,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 95%', end: 'top 45%', scrub: true },
    })

    const measure = () => {
      const next = items[setSize]
      setWidth = next ? next.offsetLeft - items[0].offsetLeft : 0
    }
    measure()
    window.addEventListener('resize', measure)
    // Los logos son lazy: al cargar cambian de ancho
    section.querySelectorAll('img').forEach(img => img.addEventListener('load', measure, { once: true }))

    ScrollTrigger.create({
      trigger: section,
      start: 'top bottom',
      end: 'bottom top',
      scrub: true,
      onUpdate: self => {
        if (!setWidth) return
        gsap.set(track, { x: gsap.utils.wrap(-setWidth, 0, -self.progress * setWidth * 2.5) })
      },
    })
  }

  /* ── Reveals genéricos por atributo ── */
  const initReveals = () => {
    // Títulos: cada línea sube detrás de una máscara (como "Trabajos" en el home)
    gsap.utils.toArray<HTMLElement>('[data-split]').forEach(title => {
      SplitText.create(title, {
        type: 'lines',
        mask: 'lines',
        linesClass: 'lp-line',
        autoSplit: true,
        onSplit: self =>
          gsap.from(self.lines, {
            yPercent: 110,
            duration: 1.1,
            stagger: 0.1,
            ease: 'power4.out',
            scrollTrigger: { trigger: title, start: 'top 85%' },
          }),
      })
    })

    // Bloques sueltos
    gsap.utils.toArray<HTMLElement>('[data-rise]').forEach(el => {
      gsap.from(el, {
        y: 40,
        opacity: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      })
    })

    // Listas: los hijos entran en cascada
    gsap.utils.toArray<HTMLElement>('[data-stagger]').forEach(list => {
      gsap.from(list.children, {
        y: 60,
        opacity: 0,
        duration: 0.9,
        stagger: 0.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: list, start: 'top 82%' },
      })
    })

    // Iconos y números: "saltan" como los stickers del bloque Estudio
    gsap.utils.toArray<HTMLElement>('[data-pop]').forEach(el => {
      gsap.from(el, {
        scale: 0,
        rotation: -25,
        duration: 0.7,
        delay: 0.25,
        ease: 'back.out(2)',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      })
    })

    // Portadas y formulario: se destapan con clip-path (como los proyectos del home)
    const clipFrom = { clipPath: 'inset(12% 6% 0% 6% round 2rem)' }
    const clipTo = { clipPath: 'inset(0% 0% 0% 0% round 0rem)', clearProps: 'clipPath', duration: 1.3, ease: 'power3.out' }

    gsap.utils.toArray<HTMLElement>('.lp-case-item').forEach(item => {
      const trigger = { trigger: item, start: 'top 90%' }
      gsap.from(item, { y: 80, opacity: 0, duration: 1, ease: 'power3.out', scrollTrigger: trigger })
      gsap.fromTo(item.querySelector('.lp-case-media'), clipFrom, { ...clipTo, scrollTrigger: trigger })
    })

    gsap.utils.toArray<HTMLElement>('[data-clip]').forEach(el => {
      gsap.fromTo(el, clipFrom, { ...clipTo, scrollTrigger: { trigger: el, start: 'top 85%' } })
    })

    // Frase de cierre: cada letra se enciende en naranja y se asienta (como el bloque final del home)
    gsap.utils.toArray<HTMLElement>('[data-glow]').forEach(line => {
      const { chars } = SplitText.create(line, { type: 'words,chars' })
      gsap.set(chars, { color: 'rgba(255, 255, 255, 0.18)' })
      const tl = gsap.timeline({
        scrollTrigger: { trigger: line, start: 'top 85%', end: 'top 35%', scrub: 0.8 },
      })
      const span = 85
      const step = 3.5
      chars.forEach((char, i) => {
        const at = (i / chars.length) * span
        tl.to(char, { color: PEAK, scale: 1.12, rotation: () => gsap.utils.random(-4, 4), duration: step, ease: 'power1.out' }, at)
          .to(char, { color: SETTLE, scale: 1, rotation: 0, duration: step, ease: 'power1.inOut' }, at + step)
      })
    })

    // Proceso: la barra se llena mientras recorres los pasos
    gsap.to('.lp-process-progress', {
      scaleX: 1,
      ease: 'none',
      scrollTrigger: { trigger: '#lp-process', start: 'top 70%', end: 'bottom 70%', scrub: true },
    })
  }

  const init = () => {
    initFaq()
    initCursor()

    if (reduceMotion) {
      root.classList.remove('lp-motion')
      gsap.set('.lp-process-progress', { scaleX: 1 })
      return
    }

    initHero()
    initLogos()
    initReveals()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>
