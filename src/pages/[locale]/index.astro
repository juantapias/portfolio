---
import { useTranslations } from '../../utils/i18n'
import Layout from '../../layouts/layout.astro'
import About from '../../sections/about.astro'
import Brands from '../../sections/Brands.astro'
import Hero from '../../sections/hero.astro'
import Inspiration from '../../sections/Inspiration.astro'
import Projects from '../../sections/projects/Projects'
import Works from '../../sections/works.astro'

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
  ]
}

const locale = Astro.params.locale as 'es' | 'en'

const seo = {
  es: {
    title: 'Tapias — Estudio de Diseño y Desarrollo Web, UI/UX y Branding',
    description: 'Estudio de diseño y desarrollo web, UI/UX, branding, apps y sistemas de diseño para marcas y negocios de Latinoamérica y el mundo. Por Juan Tapias.',
  },
  en: {
    title: 'Tapias — Web Design & Development Studio, UI/UX and Branding',
    description: 'Web design and development studio for brands in Latin America and worldwide: UI/UX, branding, app design, design systems and social media. By Juan Tapias.',
  },
}

const siteUrl = 'https://juantapias.dev'
const t = useTranslations(locale)
const services = (t('Works.services') as unknown as { label: string; description: string }[]) ?? []

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: `${siteUrl}/${locale}`,
    name: 'Juan Tapias',
    inLanguage: locale === 'es' ? 'es-CO' : 'en-US',
    publisher: { '@id': `${siteUrl}/#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Juan Tapias',
    url: siteUrl,
    image: `${siteUrl}/images/og-image.jpg`,
    jobTitle: locale === 'es' ? 'Diseñador y desarrollador web, fundador de Tapias' : 'Web designer & developer, founder of Tapias',
    description: seo[locale].description,
    worksFor: { '@id': `${siteUrl}/#service` },
    email: 'mailto:dev.juantapias@gmail.com',
    knowsAbout: [
      'Web design', 'Web development', 'UI/UX design', 'Branding', 'App design',
      'Design systems', 'Social media management', 'Astro', 'React',
    ],
    sameAs: [
      'https://github.com/juantapias',
      'https://www.instagram.com/tapias.dev/',
      'https://www.tiktok.com/@tapias.dev/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}/#service`,
    name: 'Tapias',
    alternateName: ['Tapias Studio', 'Juan Tapias'],
    description: seo[locale].description,
    url: siteUrl,
    image: `${siteUrl}/images/og-image.jpg`,
    founder: { '@id': `${siteUrl}/#person` },
    serviceType: ['Web design', 'Web development', 'UI/UX design', 'Branding', 'App design', 'Design systems', 'Social media management'],
    areaServed: [
      { '@type': 'Place', name: 'Latin America' },
      { '@type': 'Place', name: 'Worldwide' },
    ],
    availableLanguage: ['es', 'en'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: locale === 'es' ? 'Servicios' : 'Services',
      itemListElement: Array.isArray(services)
        ? services.map(s => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: s.label, description: s.description },
          }))
        : [],
    },
  },
]
---

<Layout title={seo[locale].title} description={seo[locale].description}>
  <link rel="preload" as="image" href="/images/banner.jpg" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Hero />
  <Works />
  <Projects locale={locale} client:load />
  <About />
  <Inspiration />
  <Brands />
</Layout>