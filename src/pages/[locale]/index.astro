---
import Layout from '../../layouts/layout.astro'
import About from '../../sections/about.astro'
import Hero from '../../sections/hero.astro'
import Inspiration from '../../sections/Inspiration.astro'
import Projects from '../../sections/projects/Projects'
import Works from '../../sections/works.astro'

export function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
  ]
}

const locale = Astro.params.locale as 'es' | 'en'

const seo = {
  es: {
    title: 'Juan Tapias — Diseñador y Desarrollador Front-end',
    description: 'Portafolio de Juan Tapias: diseñador y desarrollador front-end especializado en experiencias digitales intuitivas, UI/UX y branding.',
  },
  en: {
    title: 'Juan Tapias — Front-end Designer & Developer',
    description: 'Portfolio of Juan Tapias: front-end designer and developer specialized in intuitive digital experiences, UI/UX and branding.',
  },
}
---

<Layout title={seo[locale].title} description={seo[locale].description}>
  <link rel="preload" as="image" href="/images/banner.jpg" slot="head" />
  <Hero />
  <Works />
  <Projects locale={locale} client:load />
  <About />
  <Inspiration />
</Layout>