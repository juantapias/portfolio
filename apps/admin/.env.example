# ─── Supabase (Project Settings → API Keys) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ─── Supabase Storage (S3) · solo servidor ────────────────────────────
# Project Settings → Storage → S3 Connection. Ignoran RLS: nunca NEXT_PUBLIC_.
SUPABASE_S3_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-2
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# ─── Google (cuenta de servicio: GA4 + Search Console) ────────────────
# Ver docs/integraciones.md §1. La misma cuenta lee GA4 y Search Console.
GA4_PROPERTY_ID=555139844
GSC_SITE_URL=sc-domain:juantapias.dev
GOOGLE_SA_CLIENT_EMAIL=admin-analytics@tu-proyecto.iam.gserviceaccount.com
# private_key del JSON, con los \n tal cual y entre comillas
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Instagram / Meta (ver docs/integraciones.md §2) ──────────────────
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://admin.juantapias.dev/api/integrations/instagram/callback

# ─── TikTok (ver docs/integraciones.md §3) ────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://admin.juantapias.dev/api/integrations/tiktok/callback

# ─── Formulario de la landing → CRM (/api/public/leads) ───────────────
# Orígenes que pueden enviar leads (separados por coma)
LEADS_ALLOWED_ORIGINS=https://juantapias.dev,http://localhost:4321
# Sal para el hash de IP del límite de envíos (cualquier texto largo aleatorio)
LEADS_IP_SALT=

# ─── Portfolio ────────────────────────────────────────────────────────
# Deploy hook de Vercel del proyecto "web" (para regenerar al editar proyectos)
VERCEL_DEPLOY_HOOK_WEB=
# Protege los endpoints de cron (/api/cron/*)
CRON_SECRET=
