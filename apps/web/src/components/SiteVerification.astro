---
// Tokens de verificación de buscadores. Se configuran como variables de entorno
// (Vercel → Settings → Environment Variables) para no exponerlas en el repo.
const google = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION
const bing = import.meta.env.PUBLIC_BING_SITE_VERIFICATION
---

{google && <meta name="google-site-verification" content={google} />}
{bing && <meta name="msvalidate.01" content={bing} />}
