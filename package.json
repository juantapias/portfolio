{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin",
    "build:web": "npm run build -w web",
    "build:admin": "npm run build -w admin",
    "check:web": "npm run check -w web"
  },
  "overrides": {
    "vite": "^7.3.8"
  }
}
